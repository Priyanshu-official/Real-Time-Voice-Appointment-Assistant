# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Postgres (used by docker-compose and by the FastAPI app)
POSTGRES_USER=clinic_app
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=clinic
DATABASE_URL=postgresql://clinic_app:change-me-locally@localhost:5432/clinic

# Ollama runs natively on the Mac host, not in Docker (see ADR-003/006).
# From inside a container, host.docker.internal reaches the Mac host.
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# Multi-provider LLM Configuration ("ollama", "groq", or "openai")
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
# LLM_API_KEY=gsk_your_groq_or_openai_api_key_here
# LLM_API_BASE=https://api.groq.com/openai/v1

# Piper TTS voice model path (native, or mounted into the app container)
PIPER_VOICE=en_US-lessac-medium

# LangSmith Tracing Telemetry (Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
# LANGCHAIN_API_KEY=lsv2_pt_your_langsmith_api_key_here
LANGCHAIN_PROJECT=clinic-voice-assistant

