# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Postgres (used by docker-compose and by the FastAPI app)
POSTGRES_USER=clinic_app
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=clinic
DATABASE_URL=postgresql://clinic_app:change-me-locally@localhost:5432/clinic

# Ollama runs natively on the Mac host, not in Docker (see ADR-003/006).
# From inside a container, host.docker.internal reaches the Mac host.
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# Piper TTS voice model path (native, or mounted into the app container)
PIPER_VOICE=en_US-lessac-medium
